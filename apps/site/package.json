{
  "name": "@garden-lab/site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "predev": "pnpm run sync:assets && pnpm run gen:agent-index",
    "dev": "node scripts/dev.mjs",
    "prepare:public": "pnpm run sync:assets && pnpm run gen:agent-index",
    "prebuild": "pnpm run prepare:public",
    "build": "next build",
    "sync:assets": "node scripts/sync-post-assets.mjs",
    "gen:agent-index": "tsx scripts/gen-agent-post-index.ts",
    "gen:seq-svgs": "node scripts/gen-all-seq-svgs.mjs",
    "export:private": "tsx scripts/export-private-post.ts",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "new:post": "node scripts/new-entry.mjs tech",
    "new:tech": "node scripts/new-entry.mjs tech",
    "new:fitness": "node scripts/new-entry.mjs fitness",
    "new:daily-news": "node scripts/new-entry.mjs daily-news",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.3.0",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "next": "^15.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "shiki": "^4.3.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.22.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.2",
    "@types/turndown": "^5.0.6",
    "postcss": "^8.5.16",
    "sharp": "0.35.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
