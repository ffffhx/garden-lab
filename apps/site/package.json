{
  "name": "@garden-lab/site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "predev": "pnpm run sync:assets && pnpm run gen:agent-index",
    "dev": "next dev",
    "farm:assets": "node games/farm-life/scripts/generate-assets.mjs",
    "farm:dev": "pnpm run farm:assets && vite --config games/farm-life/vite.config.ts --host 127.0.0.1",
    "farm:build": "pnpm run farm:assets && vite build --config games/farm-life/vite.config.ts",
    "forest:server": "tsx scripts/forest-shuffle-room-server.ts",
    "holdem:server": "tsx scripts/texas-holdem-room-server.ts",
    "holdem:public-proxy": "tsx scripts/texas-holdem-public-proxy.ts",
    "prepare:public": "pnpm run farm:build && pnpm run sync:assets && pnpm run sync:pet && pnpm run gen:agent-index",
    "prebuild": "pnpm run prepare:public",
    "build": "next build",
    "build:with-local-tokens": "pnpm run sync:tokens && pnpm run build",
    "sync:assets": "node scripts/sync-post-assets.mjs",
    "sync:tokens": "node scripts/sync-token-usage.mjs",
    "sync:pet": "tsx scripts/sync-blog-pet.ts",
    "gen:agent-index": "tsx scripts/gen-agent-post-index.ts",
    "export:private": "tsx scripts/export-private-post.ts",
    "start": "next start",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "new:post": "node scripts/new-entry.mjs tech",
    "new:tech": "node scripts/new-entry.mjs tech",
    "new:fitness": "node scripts/new-entry.mjs fitness",
    "new:daily-news": "node scripts/new-entry.mjs daily-news"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.3.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "next": "^15.3.0",
    "phaser": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reading-time": "^1.5.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.3.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.1",
    "postcss": "^8.5.16",
    "sharp": "0.35.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.3",
    "vite": "^8.1.2",
    "vitest": "^3.1.3"
  }
}
