# ==========================================
# Garden Lab API 环境变量配置模版
# ==========================================

# 服务监听配置
GARDEN_API_PORT=8787
GARDEN_API_HOST=0.0.0.0

# 公网访问 URL（如反向代理后带子路径，请填写完整子路径）
GARDEN_API_PUBLIC_URL=https://124-221-36-36.anyip.dev:8443/garden-api

# CORS 允许的跨域来源（英文逗号分隔）
GARDEN_ALLOWED_ORIGINS=https://ffffhx.github.io,http://localhost:3000

# 会话 Cookie 签名密钥（建议 32 位以上随机字符）
GARDEN_AUTH_SECRET=replace-with-a-random-secret-key-at-least-32-chars

# 允许访问私有功能与私密文章的 GitHub 用户名白名单（英文逗号分隔）
GARDEN_ALLOWED_GITHUB_LOGINS=ffffhx

# GitHub OAuth App 凭证（用于 GitHub 登录）
# Authorization callback URL 应配置为：${GARDEN_API_PUBLIC_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# 数据持久化目录（Docker 内部为 /data）
GARDEN_DATA_DIR=./data

# Moonshot / Kimi AI API 密钥（用于划词解释与文章问答）
KIMI_API_KEY=your_kimi_api_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
