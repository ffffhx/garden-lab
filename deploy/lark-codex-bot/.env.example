LARK_CODEX_MODE=hub
PORT=8790
LARK_EVENT_PATH=/lark/events

# Match the host user that owns ./data when using the bind mount below.
# On most Linux servers: id -u && id -g
LARK_CODEX_HUB_UID=1000
LARK_CODEX_HUB_GID=1000

LARK_APP_ID=cli_xxx
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=xxx
LARK_ENCRYPT_KEY=
LARK_BASE_URL=https://open.feishu.cn/open-apis
LARK_REPLY_MODE=openapi

# In this deployment the Mac worker replies through local lark-cli, so the
# public hub does not need App Secret.
RESULT_REPLY_MODE=worker
LARK_SEND_RUNNING_MESSAGE=false
LARK_REPLY_IN_THREAD=false
LARK_INCLUDE_CODEX_SESSION=true

LARK_ALLOWED_CHAT_IDS=
LARK_ALLOWED_USER_OPEN_IDS=ou_xxx
LARK_ACCEPT_GROUP_WITHOUT_MENTION=false
LARK_BOT_OPEN_ID=
LARK_BOT_USER_ID=
LARK_BOT_NAME=
BOT_COMMAND_PREFIX=

HUB_WORKER_TOKEN=replace-with-long-random-token
WORKER_PATH_PREFIX=/worker
HUB_QUEUE_FILE=/data/queue.json
HUB_TASK_LEASE_MS=1800000
HUB_MAX_TASKS=500
HUB_QUEUED_MESSAGE=收到，任务已进入 Codex 队列，等待 Mac worker 处理。
CODEX_MAX_OUTPUT_CHARS=6000

RELAY_ENABLED=true
RELAY_BOT_ID=codex_bot_a
RELAY_PEER_BOT_ID=codex_bot_b
RELAY_TRIGGER_PREFIX=/debate
RELAY_AUTO_START_HUMAN_TASKS=false
RELAY_NATURAL_TRIGGER_ENABLED=true
RELAY_NATURAL_TRIGGER_PATTERN=讨论|辩论|评审|评估|复盘|头脑风暴|两个.*(机器人|Codex|codex)|双机器人|A/B|AB|方案.*(讨论|评审|评估|分析)|(?:讨论|评审|评估|分析).*方案
RELAY_FINAL_ENABLED=true
RELAY_FINAL_BOT_ID=codex_bot_a
RELAY_REPLY_INTERMEDIATE=true
RELAY_MAX_TURNS=4
RELAY_TRANSCRIPT_MAX_CHARS=24000
