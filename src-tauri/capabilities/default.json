{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-pet",
  "description": "Window and opener permissions for the desktop blog pet.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "opener:default"
  ]
}
