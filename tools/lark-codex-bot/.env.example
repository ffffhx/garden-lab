# Mode
# local: Feishu -> this machine -> Codex -> Feishu
# hub: Feishu -> public server queue -> Mac worker -> public server -> Feishu
# worker: Mac polls hub -> Codex -> submit result
LARK_CODEX_MODE=local

# Server
PORT=8787
LARK_EVENT_PATH=/lark/events

# Feishu/Lark app credentials
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx
LARK_VERIFICATION_TOKEN=xxx
LARK_ENCRYPT_KEY=xxx
LARK_BASE_URL=https://open.feishu.cn/open-apis
LARK_REPLY_MODE=cli
LARK_CLI_BIN=lark-cli

# Safety gates. Strongly recommended for any bot that can run local commands.
LARK_ALLOWED_CHAT_IDS=oc_xxx
LARK_ALLOWED_USER_OPEN_IDS=ou_xxx
LARK_ACCEPT_GROUP_WITHOUT_MENTION=false

# Mention matching in group chats. If unset, any mention in the received group
# message is accepted because Feishu can be configured to deliver only @bot events.
LARK_BOT_OPEN_ID=
LARK_BOT_USER_ID=
LARK_BOT_NAME=

# Optional command gate. Example: /codex
BOT_COMMAND_PREFIX=
LARK_SEND_RUNNING_MESSAGE=true
LARK_REPLY_IN_THREAD=false
LARK_INCLUDE_CODEX_SESSION=true

# Hub/worker mode
# Use one long random value on both Aliyun hub and Mac worker.
HUB_WORKER_TOKEN=

# Hub mode: queue state stored on the public server.
HUB_QUEUE_FILE=
HUB_TASK_LEASE_MS=1800000
HUB_MAX_TASKS=500
HUB_QUEUED_MESSAGE=收到，任务已进入 Codex 队列，等待 Mac worker 处理。
WORKER_PATH_PREFIX=/worker
RESULT_REPLY_MODE=hub

# Worker mode: Mac actively polls the public hub.
HUB_BASE_URL=https://your-domain.example.com
WORKER_ID=mac-codex-worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_ERROR_RETRY_MS=5000
WORKER_SUBMIT_RETRY_MS=5000

# Codex execution
CODEX_BIN=codex
CODEX_HOME=
CODEX_WORKDIR=/Users/bytedance/Code/garden-lab
CODEX_SESSION_SCOPE=chat
CODEX_SESSION_STORE=
CODEX_MODEL=
CODEX_PROFILE=
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_CHARS=6000
CODEX_ENABLE_WEB_SEARCH=false
CODEX_EPHEMERAL=false

# Optional extra instruction prepended to each Feishu-triggered task.
CODEX_PROMPT_PREAMBLE=
