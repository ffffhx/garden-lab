# Aliyun/public server mode.
LARK_CODEX_MODE=hub
PORT=8787
LARK_EVENT_PATH=/lark/events

# Feishu app. Hub receives webhook events and replies through OpenAPI.
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx
LARK_VERIFICATION_TOKEN=xxx
LARK_ENCRYPT_KEY=
LARK_BASE_URL=https://open.feishu.cn/open-apis
LARK_REPLY_MODE=openapi
RESULT_REPLY_MODE=hub

# Safety gates. Strongly recommended because accepted tasks will run on your Mac.
LARK_ALLOWED_CHAT_IDS=oc_xxx
LARK_ALLOWED_USER_OPEN_IDS=ou_xxx
LARK_ACCEPT_GROUP_WITHOUT_MENTION=false
LARK_BOT_OPEN_ID=
LARK_BOT_USER_ID=
LARK_BOT_NAME=
BOT_COMMAND_PREFIX=

# Worker authentication. Generate a long random value and copy it to .env.worker.
HUB_WORKER_TOKEN=replace-with-long-random-token
WORKER_PATH_PREFIX=/worker

# Queue persisted on the public server.
HUB_QUEUE_FILE=/var/lib/lark-codex-bot/queue.json
HUB_TASK_LEASE_MS=1800000
HUB_MAX_TASKS=500
HUB_QUEUED_MESSAGE=收到，任务已进入 Codex 队列，等待 Mac worker 处理。

# Reply behavior.
LARK_SEND_RUNNING_MESSAGE=true
LARK_REPLY_IN_THREAD=false
LARK_INCLUDE_CODEX_SESSION=true
CODEX_MAX_OUTPUT_CHARS=6000
