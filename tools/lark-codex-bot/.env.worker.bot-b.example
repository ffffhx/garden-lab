# Worker B: challenger / reviewer.
#
# Copy to tools/lark-codex-bot/.env.worker.bot-b and fill the real hub token
# and Feishu app credentials. Keep this file as a template; do not put secrets
# in the .example file.

LARK_CODEX_MODE=worker
HUB_BASE_URL=https://your-domain.example.com
HUB_WORKER_TOKEN=replace-with-the-same-long-random-token
WORKER_PATH_PREFIX=/worker
WORKER_ID=codex-bot-b-worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_ERROR_RETRY_MS=5000
WORKER_SUBMIT_RETRY_MS=5000

RESULT_REPLY_MODE=worker
LARK_REPLY_MODE=openapi
LARK_APP_ID=cli_bot_b
LARK_APP_SECRET=replace-with-bot-b-secret
LARK_BASE_URL=https://open.feishu.cn/open-apis
LARK_CHAT_MESSAGES_READ_LIMIT=20
LARK_REPLY_IN_THREAD=false
LARK_INCLUDE_CODEX_SESSION=false

CODEX_BIN=codex
CODEX_HOME=
CODEX_WORKDIR=/Users/bytedance/Code/garden-lab
CODEX_ADD_DIRS=/Users/bytedance/Code
CODEX_SESSION_SCOPE=chat
CODEX_SESSION_STORE=tools/lark-codex-bot/.sessions.bot-b.json
CODEX_MODEL=
CODEX_PROFILE=
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_CHARS=8000
CODEX_ENABLE_WEB_SEARCH=false
CODEX_EPHEMERAL=false
CODEX_PROMPT_PREAMBLE=你是 Codex Bot B，偏重反方审查、遗漏发现、替代方案和长期维护风险。讨论时主动挑战 Bot A 的假设，并给出更稳妥的改进建议。

RELAY_ENABLED=true
RELAY_BOT_ID=codex_bot_b
RELAY_PEER_BOT_ID=codex_bot_a
RELAY_TRIGGER_PREFIX=/debate
RELAY_AUTO_START_HUMAN_TASKS=false
RELAY_FINAL_ENABLED=true
RELAY_FINAL_BOT_ID=codex_bot_a
RELAY_REPLY_INTERMEDIATE=false
RELAY_MAX_TURNS=4
RELAY_TRANSCRIPT_MAX_CHARS=24000
RELAY_VISIBLE_MENTION=@Codex-A
