# Mac worker mode.
LARK_CODEX_MODE=worker

# Public hub URL. Do not include /worker here.
HUB_BASE_URL=https://your-domain.example.com
HUB_WORKER_TOKEN=replace-with-the-same-long-random-token
WORKER_PATH_PREFIX=/worker
WORKER_ID=mac-codex-worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_ERROR_RETRY_MS=5000
WORKER_SUBMIT_RETRY_MS=5000
RESULT_REPLY_MODE=hub

# Set RESULT_REPLY_MODE=worker when the Mac should reply through local lark-cli.
LARK_REPLY_MODE=cli
LARK_CLI_BIN=lark-cli
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_URL=https://open.feishu.cn/open-apis
LARK_CHAT_MESSAGES_READ_LIMIT=20
LARK_REPLY_IN_THREAD=false
LARK_INCLUDE_CODEX_SESSION=true

# Codex execution on this Mac.
CODEX_BIN=codex
CODEX_HOME=
CODEX_WORKDIR=/Users/bytedance/Code/garden-lab
CODEX_ADD_DIRS=
CODEX_SESSION_SCOPE=chat
CODEX_SESSION_STORE=
CODEX_MODEL=
CODEX_PROFILE=
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_CHARS=6000
CODEX_ENABLE_WEB_SEARCH=false
CODEX_EPHEMERAL=false

# Optional extra instruction prepended to each Feishu-triggered task.
CODEX_PROMPT_PREAMBLE=

# Bot-to-bot relay through the same public hub.
# Both bots set RELAY_ENABLED=true. Swap RELAY_BOT_ID and RELAY_PEER_BOT_ID
# on the other Mac.
RELAY_ENABLED=false
RELAY_BOT_ID=my_codex
RELAY_PEER_BOT_ID=girlfriend_codex
RELAY_TRIGGER_PREFIX=/relay
RELAY_AUTO_START_HUMAN_TASKS=false
RELAY_FINAL_ENABLED=false
RELAY_FINAL_BOT_ID=
RELAY_REPLY_INTERMEDIATE=true
RELAY_MAX_TURNS=6
RELAY_TRANSCRIPT_MAX_CHARS=24000

# Optional visible prefix for Feishu replies. This is for display; the real
# trigger is still the hub queue, not Feishu bot-to-bot message events.
RELAY_VISIBLE_MENTION=@女朋友的Codex
