# Mac worker mode.
LARK_CODEX_MODE=worker

# Public hub URL. Do not include /worker here.
HUB_BASE_URL=https://your-domain.example.com
HUB_WORKER_TOKEN=replace-with-the-same-long-random-token
WORKER_PATH_PREFIX=/worker
WORKER_ID=mac-codex-worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_ERROR_RETRY_MS=5000
WORKER_SUBMIT_RETRY_MS=5000
RESULT_REPLY_MODE=hub

# Set RESULT_REPLY_MODE=worker when the Mac should reply through local lark-cli.
LARK_REPLY_MODE=cli
LARK_CLI_BIN=lark-cli
LARK_REPLY_IN_THREAD=false
LARK_INCLUDE_CODEX_SESSION=true

# Codex execution on this Mac.
CODEX_BIN=codex
CODEX_HOME=
CODEX_WORKDIR=/Users/bytedance/Code/garden-lab
CODEX_SESSION_SCOPE=chat
CODEX_SESSION_STORE=
CODEX_MODEL=
CODEX_PROFILE=
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_CHARS=6000
CODEX_ENABLE_WEB_SEARCH=false
CODEX_EPHEMERAL=false

# Optional extra instruction prepended to each Feishu-triggered task.
CODEX_PROMPT_PREAMBLE=
